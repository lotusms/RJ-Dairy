AUTH_TYPE=UsernamePassword
DATABASE=(default)
DATABASE_REGION=us-east1
DEFAULT_FROM=payables@rjdairy.com
DEFAULT_REPLY_TO=payables@rjdairy.com
firebaseextensions.v1beta.function/location=us-east1
MAIL_COLLECTION=rd)
OAUTH_PORT=465
OAUTH_SECURE=false
SMTP_CONNECTION_URI=smtps://payables@rjdairy.com@smtp.office365.com:587
TTL_EXPIRE_TYPE=never
TTL_EXPIRE_VALUE=1
USER=SMTP connection URI (Optional): A URI representing an SMTP server this extension can use to deliver email. Note that port 25 is blocked by Google Cloud Platform, so we recommend using port 587 for SMTP connections. If you're using the SMTPS protocol, we recommend using port 465. In order to keep passwords secure, it is recommended to omit the password from the connection string while using the SMTP Password field for entering secrets and passwords. Passwords and secrets should now be included in SMTP password field.